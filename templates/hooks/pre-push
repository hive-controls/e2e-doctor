#!/usr/bin/env bash
# Replay on the configured FORMIC_GATE; on failure run heal with an evidence bundle.
# Exit 0 allows the push (replay passed or heal verified a repair).
# Exit 1 refuses: needs-human/unhealed. Exit 2 refuses: harness/configuration failure.
# Exit 3 refuses: preview unavailable; restore it and retry. Unexpected codes become 2.
# Healed proposals remain in the bundle; review and commit any desired spec change.
# Configuration: E2E_DOCTOR_SPEC, E2E_DOCTOR_APP, E2E_DOCTOR_BUNDLE, E2E_DOCTOR_BIN.
set -u

PATH="$PWD/node_modules/.bin:$PATH"
export PATH
doctor="${E2E_DOCTOR_BIN:-e2e-doctor}"
spec="${E2E_DOCTOR_SPEC:-specs/approve-an-order.yaml}"
app="${E2E_DOCTOR_APP:-sample-app}"
template_dir="$(cd "$(dirname "$0")/.." && pwd)" || exit 2

if "$doctor" replay "$spec" --app "$app"; then
  echo "E2E Doctor: replay passed; push allowed."
  exit 0
fi

bash "$template_dir/scripts/e2e-doctor-heal.sh"
result=$?
case "$result" in
  0) echo "E2E Doctor: heal verified; push allowed." ;;
  1) echo "Push refused: E2E Doctor needs human review." >&2 ;;
  2) echo "Push refused: E2E Doctor harness failed." >&2 ;;
  3) echo "Push refused: E2E Doctor preview unavailable; restore it and retry." >&2 ;;
  *) echo "Push refused: unexpected E2E Doctor exit $result." >&2; result=2 ;;
esac
exit "$result"
